# ServiceNow connection settings
SN_INSTANCE_URL=https://<your-instance>.service-now.com
SN_USER=<username>
SN_PASS=<password>
SN_TABLE_NAME=incident

# OpenAI settings
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo
